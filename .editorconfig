root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_style = space
indent_size = 2

# Test names use Method_Scenario_ExpectedResult, so underscores are intended there.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
