{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DuelLab": "Host=localhost;Port=5432;Database=duellab;Username=duellab;Password=duellab"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "CardCatalog": {
    "Provider": "YgoProDeck",
    "ImportOnStartup": true,
    "ImageCachePath": "data/card-images",
    "MaxImageDownloadsPerSecond": 10
  }
}
